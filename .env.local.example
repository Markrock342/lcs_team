# Supabase (Auth + Storage only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Neon PostgreSQL (server-only; never prefix with NEXT_PUBLIC_)
DATABASE_URL=postgresql://user:password@host/db?sslmode=verify-full

# LCS Assistant (server-only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# GitHub Code Workspace (fine-grained token: Contents read-only)
GITHUB_READ_TOKEN=
# Comma-separated repositories that are not already linked through clients.repo_url
GITHUB_DEFAULT_REPOSITORIES=Markrock342/lcs_team

# URL ของแอพ (local = localhost, production = https://lcs-team.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (run: node scripts/generate-vapid.js)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@limitcode.dev
